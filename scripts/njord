#!/usr/bin/env bash
# Single entry point for building, testing and running the simulator.
# CI (.github/workflows/ci.yml) calls the same commands as users.
#
#   ./scripts/njord help
#
# Settings are passed as environment variables (see compose.yaml and
# docs/configuration.md), e.g. SEED=2 PROFILE=conservative ./scripts/njord demo slalom
set -euo pipefail
cd "$(dirname "$0")/.."

export RUNNER_GIT_COMMIT="$(git rev-parse HEAD 2>/dev/null || echo unknown)"
# Containers run as the calling user so files in outputs/ stay editable.
export NJORD_UID="$(id -u)"
export NJORD_GID="$(id -g)"
# Images published by CI after the container tests pass.
registry="${NJORD_REGISTRY_IMAGE:-ghcr.io/martinnordli/surface_vessel_simulation}"
local_image="${NJORD_IMAGE:-njord-sim:local}"

# Compose overlays: software rendering, WSLg graphics, or the native GPU setup.
if [ "${NJORD_CPU:-0}" = 1 ]; then
  export COMPOSE_FILE="${COMPOSE_FILE:-compose.yaml:compose.cpu.yaml}"
elif grep -qi microsoft /proc/sys/kernel/osrelease; then
  export COMPOSE_FILE="${COMPOSE_FILE:-compose.yaml:compose.wsl.yaml}"
else
  export COMPOSE_FILE="${COMPOSE_FILE:-compose.yaml}"
fi

action="${1:-demo}"
shift || true

courses() {
  local names=() file
  for file in scenarios/*.yaml; do names+=("$(basename "$file" .yaml)"); done
  echo "${names[*]}"
}

usage() {
  cat <<EOF
Usage: scripts/njord <command> [course] [extra arguments]

Image
  pull [tag]      Download the CI-tested image for this commit (or a tag, e.g. latest)
  build           Build the image locally (after changing files copied into it)
  check-image     Fail unless the image was built from this checkout
  doctor          Check Docker, Compose, NVIDIA and the image

Run (course defaults to SCENARIO, else reference)
  demo [course]       Headless race: simulator + autonomy + evaluator; exits with the result
  gui [course]        Same race with the Gazebo window and RViz
  lab [course]        Free driving: simulator + autonomy, no evaluator (RUN_MODE=free)
  simulator [course]  Simulator service only
  benchmark [course]  Seed x environment x profile race matrix (see --help)
  campaign           Fresh-process physical parameter and timestep trials (see --help)

Test
  test            Full unit/integration suite inside the container
  selftest        Start simulator + autonomy, check live sensors and navigation, stop
  smoke           Check live sensors against an already running stack

Courses: $(courses)
Common settings: SEED, ENVIRONMENT, PROFILE, VESSEL_CONFIG, ALGORITHMS_CONFIG,
CONTROLLER/PERCEPTION/MAPPING/AUTONOMY=external, STATE_SOURCE=truth (navigate on
ground truth instead of the GPS/IMU estimate). NJORD_CPU=1 uses software
rendering on hosts without a usable GPU.
EOF
}

# Resolve the tag once before checking labels or starting any service.
pin_image() {
  local pinned
  pinned="$(docker image inspect "$local_image" --format '{{.Id}}')"
  export NJORD_IMAGE="$pinned" IMAGE_ID="$pinned"
  local_image="$pinned"
  docker compose config --format json | python3 -c '
import json, os, sys
services = json.load(sys.stdin)["services"]
for name in ("simulator", "autonomy", "evaluator", "tests"):
    if name in services and services[name]["image"] != os.environ["NJORD_IMAGE"]:
        raise SystemExit("Compose service " + name + " must honor NJORD_IMAGE")
'

}

# Image tests require all build inputs; runs permit editable config YAML only.
check_image() {
  local kind="${1:-source}" built expected full
  pin_image
  built="$(docker image inspect "$local_image" --format "{{ index .Config.Labels \"io.njord.${kind}.digest\" }}")"
  expected="$(python3 scripts/build_metadata.py --field "${kind}_digest")"
  full="$(docker image inspect "$local_image" --format '{{ index .Config.Labels "io.njord.source.digest" }}')"
  if [[ ! "$full" =~ ^[0-9a-f]{64}$ ]]; then
    echo 'Image full source digest is missing or malformed; rebuild.' >&2
    return 1
  fi
  if [ "$built" != "$expected" ]; then
    echo "Image $local_image has a missing or mismatched $kind digest" >&2
    echo "  image: ${built:-none}; checkout: $expected" >&2
    echo 'Run ./scripts/njord build after source/model changes.' >&2
    return 1
  fi
  echo "Image $local_image matches this checkout ($kind)"
}

# Pin the immutable image ID, create a unique run ID and a fresh output
# directory. A directory that already holds a finished run is never reused.
prepare_run() {
  check_image executable
  export RUN_ID="$(python3 -c 'import uuid; print(uuid.uuid4().hex)')"
  export OUTPUT_HOST="${OUTPUT_HOST:-$PWD/outputs/$1-$(date -u +%Y%m%dT%H%M%S)}"
  if [ -e "$OUTPUT_HOST/run_ready.json" ]; then
    echo "Select a fresh OUTPUT_HOST; this directory contains a previous run" >&2
    exit 2
  fi
  mkdir -p "$OUTPUT_HOST"
}

# A first argument naming a file in scenarios/ selects that course; it
# overrides SCENARIO. Scenarios are copied into the image at build time.
case "$action" in
  demo|gui|lab|simulator|benchmark)
    if [ -n "${1:-}" ] && [ -f "scenarios/$1.yaml" ]; then
      export SCENARIO="/opt/njord/scenarios/$1.yaml"
      shift
    fi
    ;;
esac

case "$action" in
  help|-h|--help) usage ;;
  pull)
    if [ -n "${1:-}" ]; then
      tag="$1"
    elif [ "$RUNNER_GIT_COMMIT" != unknown ]; then
      tag="sha-$RUNNER_GIT_COMMIT"
    else
      echo 'Not a Git checkout: pass a tag, e.g. ./scripts/njord pull latest' >&2
      exit 2
    fi
    if ! docker pull "$registry:$tag"; then
      echo "No published image $registry:$tag." >&2
      echo 'CI publishes an image for each commit pushed to GitHub once its tests pass.' >&2
      echo 'Wait for CI, pull another tag (e.g. latest for main), or run ./scripts/njord build.' >&2
      exit 1
    fi
    docker tag "$registry:$tag" "$local_image"
    echo "Tagged $registry:$tag as $local_image"
    check_image
    ;;
  build)
    # Bake the source commit and digest into the image for provenance.
    source_digest="$(python3 scripts/build_metadata.py --field source_digest)"
    docker compose build \
      --build-arg "NJORD_IMAGE_SOURCE_COMMIT=$RUNNER_GIT_COMMIT" \
      --build-arg "NJORD_IMAGE_SOURCE_DIGEST=$source_digest" \
      --build-arg "NJORD_IMAGE_EXECUTABLE_DIGEST=$(python3 scripts/build_metadata.py --field executable_digest)" "$@"
    ;;
  check-image) check_image ;;
  test|runtime-test)
    if [ "$action" = runtime-test ]; then check_image executable; else check_image; fi
    mkdir -p outputs/demo
    docker compose run --rm tests "$@"
    ;;
  selftest)
    prepare_run selftest
    trap 'docker compose down --timeout 10' EXIT INT TERM
    docker compose up --detach simulator autonomy
    deadline=$((SECONDS + ${SELFTEST_READY_TIMEOUT_S:-300}))
    until [ -e "$OUTPUT_HOST/run_ready.json" ]; do
      if [ "$SECONDS" -ge "$deadline" ]; then
        echo 'Simulator did not publish run_ready.json in time' >&2
        docker compose logs --no-color simulator autonomy | tail -200 >&2
        exit 1
      fi
      sleep 2
    done
    if ! docker compose run --rm -e "SMOKE_TIMEOUT_S=${SMOKE_TIMEOUT_S:-240}" autonomy \
        python3 /opt/njord/validation/check_runtime.py; then
      docker compose logs --no-color simulator autonomy | tail -200 >&2
      exit 1
    fi
    ;;
  demo|gui|lab|simulator)
    if [ "$action" = gui ]; then export COMPOSE_FILE="$COMPOSE_FILE:compose.gui.yaml"; fi
    prepare_run run
    trap 'docker compose down --timeout 10' EXIT INT TERM
    if [ "$action" = simulator ]; then
      docker compose up simulator "$@"
    elif [ "$action" = lab ]; then
      # Free driving: the guard needs no race-active signal from an evaluator.
      export RUN_MODE=free
      # Interactive inspection uses short-lived compose run containers. Their
      # exit must not tear down the ongoing sensor session.
      docker compose up simulator autonomy "$@"
    else
      # The evaluator's exit code (0 = course completed) becomes ours.
      docker compose up --abort-on-container-exit --exit-code-from evaluator simulator autonomy evaluator "$@"
    fi
    ;;
  benchmark) exec python3 scripts/benchmark.py "$@" ;;
  campaign) exec python3 scripts/dynamics_campaign.py "$@" ;;
  smoke) check_image executable; docker compose run --rm autonomy python3 /opt/njord/validation/check_runtime.py "$@" ;;
  doctor)
    docker version
    docker compose version
    if [ "${NJORD_CPU:-0}" = 1 ]; then
      echo 'NJORD_CPU=1: software rendering, skipping NVIDIA checks'
    else
      nvidia-smi
      docker compose run --rm simulator nvidia-smi
    fi
    check_image
    ;;
  *) usage >&2; exit 2 ;;
esac
